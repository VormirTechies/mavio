{
  "name": "mavio-workspace",
  "version": "0.0.0",
  "private": true,
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "engines": {
    "node": "^22.0.0 || ^24.0.0"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@ffmpeg/core": "0.12.10",
    "@types/node": "22.20.4",
    "esbuild": "0.28.2",
    "eslint": "10.11.0",
    "eslint-config-prettier": "10.1.8",
    "globals": "17.12.0",
    "playwright": "1.63.0",
    "prettier": "3.9.9",
    "typescript": "6.0.3",
    "typescript-eslint": "8.70.1"
  },
  "scripts": {
    "build": "npm run build --workspace=@vormirtech/mavio",
    "typecheck": "npm run typecheck --workspace=@vormirtech/mavio",
    "test:types": "npm run test:types --workspace=@vormirtech/mavio",
    "test": "npm run test --workspace=@vormirtech/mavio && node --test scripts/minimize-browser-regression.test.mjs scripts/browser-core.test.mjs",
    "test:package": "npm run build && node scripts/check-package.mjs",
    "lint": "eslint packages scripts examples eslint.config.mjs --max-warnings=0",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "check": "npm run lint && npm run format:check && npm run build && npm run typecheck && npm run test:types && npm test && npm run test:package",
    "check:native": "npm run build && node scripts/check-native-tools.mjs",
    "check:native:media": "npm run build && node scripts/check-native-media.mjs",
    "check:native:audio": "npm run build && node scripts/check-native-audio.mjs",
    "check:native:thumbnail": "npm run build && node scripts/check-native-thumbnail.mjs",
    "check:native:all": "npm run build && node scripts/check-native-all.mjs",
    "check:browser:assets": "node scripts/check-browser-engine-assets.mjs",
    "check:browser:regression": "node scripts/check-browser-regression.mjs",
    "check:browser:engine": "npm run check:browser:assets && node scripts/check-browser-engine.mjs",
    "check:browser:client": "npm run build && npm run check:browser:assets && node scripts/check-browser-client.mjs",
    "check:browser:verified": "npm run build && node scripts/check-browser-verified.mjs",
    "check:examples": "npm run build && node scripts/check-examples.mjs",
    "benchmark:native": "npm run build && node scripts/benchmark-native.mjs",
    "benchmark:browser": "node scripts/benchmark-browser.mjs",
    "check:resources:native": "npm run build && node --expose-gc scripts/check-native-resources.mjs",
    "check:resources:browser": "node scripts/check-browser-resources.mjs",
    "check:m6": "npm run build && node scripts/check-m6.mjs",
    "check:native:policy": "npm run build && node scripts/check-native-input-policy.mjs"
  }
}
