{
  "name": "mavio-example-vanilla-ts",
  "private": true,
  "type": "module",
  "engines": {
    "node": "^22.0.0 || ^24.0.0"
  },
  "scripts": {
    "assets": "mavio-browser-assets public/mavio-engine",
    "build": "esbuild src/main.ts --bundle --format=esm --platform=browser --target=es2022 --outfile=public/app.js",
    "start": "node ../shared/serve.mjs",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@ffmpeg/core": "0.12.10",
    "esbuild": "0.28.2",
    "typescript": "6.0.3"
  }
}
